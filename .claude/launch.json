{
  "version": "0.0.1",
  "autoPort": false,
  "configurations": [
    {
      "name": "Next.js dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "Convex dev",
